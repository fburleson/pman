name: Release
on:
  push:
    tags:
      - "v*"

permissions:
  contents: read

concurrency:
  group: release-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
  verify_version:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: verify tag matches project version
        run: |
          tag_version="${GITHUB_REF_NAME#v}"
          project_version="$(uv version --short)"
          if [ "$tag_version" != "$project_version" ]; then
            echo "::error::tag $GITHUB_REF_NAME does not match project version $project_version"
            exit 1
          fi
{%- if lib %}

  build:
    runs-on: ubuntu-latest
    needs: [verify_version]
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv build
      - uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/*
          if-no-files-found: error

#  publish_pypi:
#    runs-on: ubuntu-latest
#    needs: [build]
#    permissions:
#      id-token: write
#    steps:
#      - uses: astral-sh/setup-uv@v5
#      - uses: actions/download-artifact@v4
#        with:
#          name: dist
#          path: dist
#      - name: publish to PyPI
#        run: uv publish --trusted-publishing always dist/*
{%- endif %}

  github_release:
    runs-on: ubuntu-latest
    needs: [verify_version{% if lib %}, build{% endif %}]
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

{%- if lib %}
      - uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist
{%- endif %}
      - name: create GitHub release
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: gh release create "$GITHUB_REF_NAME" {% if lib %}dist/* {% endif %}--generate-notes --title "$GITHUB_REF_NAME"
